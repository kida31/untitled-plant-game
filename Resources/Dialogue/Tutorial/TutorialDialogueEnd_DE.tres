[sub_resource type="Resource" id="Resource_acleb"]
script = ExtResource("1_g76ho")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_whf5q")
dialogueText = "Ah, eine Sache, die ich noch vergessen habe."

[sub_resource type="Resource" id="Resource_tmh6s"]
script = ExtResource("1_g76ho")
speakerName = "Samentasche"
DialogueExpression = ExtResource("3_t0gpa")
dialogueText = "Wenn du neue Samen hast kannst du diese mit der [color=red]Samentasche[/color] einpflanzen."

[sub_resource type="Resource" id="Resource_yg4ah"]
script = ExtResource("1_g76ho")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_yrkhe")
dialogueText = "Die Samentasche hält immer den ersten Samen, der sich in deinem Inventar befindet."

[sub_resource type="Resource" id="Resource_66we5"]
script = ExtResource("1_g76ho")
speakerName = "Gottfried"
DialogueExpression = ExtResource("5_u0prq")
dialogueText = "Oh und wenn deine Pflanzen sterben, dann kannst du diese auch ausgraben."

[sub_resource type="Resource" id="Resource_i3e76"]
script = ExtResource("1_g76ho")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_yrkhe")
dialogueText = "Dafür benutzt du die [color=red]Schaufel[/color]. Pass aber auf, dass du nicht ausversehen deine lebendigen Pflanzen ausgräbst!"

[sub_resource type="Resource" id="Resource_8febt"]
script = ExtResource("1_g76ho")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_yrkhe")
dialogueText = "Tja, mehr kann ich dir  auch nicht mehr beibringen. Falls du fragen hast sprich mich gerne wieder an."
