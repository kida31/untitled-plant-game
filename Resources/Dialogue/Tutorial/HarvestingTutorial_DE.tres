[sub_resource type="Resource" id="Resource_5fiqd"]
script = ExtResource("2_njduk")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_cvsfc")
dialogueText = "Perfekt! Es scheint als hättest du es hinbekommen etwas zu gießen."
