[sub_resource type="Resource" id="Resource_hhqf7"]
script = ExtResource("2_njduk")
speakerName = "Schere"
DialogueExpression = ExtResource("3_g3cto")
dialogueText = "Als nächstes gibt es noch die [color=redGartenschere[/color] . Die Gartenschere hilft dir sauber Pflanzen zu ernten."

[sub_resource type="Resource" id="Resource_wfp6x"]
script = ExtResource("2_njduk")
speakerName = "Schere"
DialogueExpression = ExtResource("3_g3cto")
dialogueText = "Nachdem du die Pflanzen geerntet hast, werden sie nach einer Zeit auch wieder neu wachsen, wenn du dich um diese kümmerst."

[sub_resource type="Resource" id="Resource_6v888"]
script = ExtResource("2_njduk")
