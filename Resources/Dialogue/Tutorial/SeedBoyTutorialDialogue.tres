[sub_resource type="Resource" id="Resource_sr1yf"]
script = ExtResource("1_8g2n2")
speakerName = "Laya"
dialogueText = "Die Frucht wurde verkauft. Was mache ich mit dem Geld?"

[sub_resource type="Resource" id="Resource_g71vq"]
script = ExtResource("1_8g2n2")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_lx0ib")
dialogueText = "Oh, das hört sich doch gut an! Wenn aus dem Automaten etwas verkauft wurde findest du dort auch das Geld."

[sub_resource type="Resource" id="Resource_sqv14"]
script = ExtResource("1_8g2n2")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_lx0ib")
dialogueText = "Mit dem Geld kannst du dann auch Samen kaufen."

[sub_resource type="Resource" id="Resource_wdbcu"]
