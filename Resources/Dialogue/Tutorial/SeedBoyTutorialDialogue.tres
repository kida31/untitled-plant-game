[sub_resource type="Resource" id="Resource_t4mgt"]
script = ExtResource("1_8g2n2")
speakerName = "Gottfried"
DialogueExpression = ExtResource("4_fgbo0")
dialogueText = "Dort steht Pan Dan. Er ist der Junge vom ehemaligen Supermarkt Besitzer."

[sub_resource type="Resource" id="Resource_il2tp"]
script = ExtResource("1_8g2n2")
speakerName = "Gottfried"
DialogueExpression = ExtResource("5_bw11t")
dialogueText = "Er sammelt immer alles mögliche an Dingen. Sicherlich kann er dir auch ein paar Samen verkaufen."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_ed3bb"]
script = ExtResource("1_8g2n2")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_lx0ib")
dialogueText = "Sprich ihn doch mal an. Vielleicht hat er etwas, was dich interessiert."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

