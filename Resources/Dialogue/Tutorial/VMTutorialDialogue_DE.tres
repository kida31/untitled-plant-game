[sub_resource type="Resource" id="Resource_iey8o"]
script = ExtResource("2_5o44g")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_bbu3w")
dialogueText = "Wusstest du, dass Chuberrys sehr beliebt sind zur Zeit?"

[sub_resource type="Resource" id="Resource_wieva"]
script = ExtResource("2_5o44g")
speakerName = "Gottfried"
DialogueExpression = ExtResource("3_5wycx")
dialogueText = "Sie wirken besonders gut gegen Erkältungen und haben eine [color=red]wärmende[/color] Eigenschaft."

[sub_resource type="Resource" id="Resource_w4rvn"]
script = ExtResource("2_5o44g")
speakerName = "Gottfried"
DialogueExpression = ExtResource("4_l5ard")
dialogueText = "In dem [color=red]Automaten[/color] dort kannst du deine [color=green]Medizin[/color] verkaufen."

[sub_resource type="Resource" id="Resource_3a3xs"]
script = ExtResource("2_5o44g")
speakerName = "Gottfried"
DialogueExpression = ExtResource("3_5wycx")
dialogueText = "Die Preise für die Medizin kannst du selber bestimmen. Aber stelle sicher, dass du es mit den Preisen nicht übertreibst, ja?"
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_cb3gn"]
script = ExtResource("2_5o44g")
speakerName = "Gottfried"
DialogueExpression = ExtResource("5_a6ba3")
dialogueText = "Ich erinnere mich noch an Zeiten, als der alte Herbalist wirklich geizig war!"
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_f3jpg"]
script = ExtResource("2_5o44g")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_bbu3w")
dialogueText = "Stell doch die Chuberry ein, die du eben geerntet hast und warte ab, ob jemand sie kauft."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

