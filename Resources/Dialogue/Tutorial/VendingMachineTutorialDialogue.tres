[sub_resource type="Resource" id="Resource_iey8o"]
script = ExtResource("1_454lr")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_4tb82")
dialogueText = "Wusstest du, dass Chuberrys sehr beliebt sind zur Zeit?"

[sub_resource type="Resource" id="Resource_wieva"]
script = ExtResource("1_454lr")
speakerName = "Gottfried"
DialogueExpression = ExtResource("4_x6cgm")
dialogueText = "Sie wirken besonders gut gegen Erkältungen und haben eine [color=red]wärmende[/color] Eigenschaft."

[sub_resource type="Resource" id="Resource_w4rvn"]
script = ExtResource("1_454lr")
speakerName = "Gottfried"
DialogueExpression = ExtResource("4_ulpu2")
dialogueText = "In dem [color=red]Automaten[/color] dort kannst du deine [color=green]Medizin[/color] verkaufen."

[sub_resource type="Resource" id="Resource_btpbq"]
