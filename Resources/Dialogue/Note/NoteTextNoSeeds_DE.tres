[sub_resource type="Resource" id="Resource_ikaoc"]
script = ExtResource("1_cbble")
speakerName = "Laya"
dialogueText = "\"Liebe Laya\""
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_6f3q6"]
script = ExtResource("1_cbble")
speakerName = "Laya"
dialogueText = "\"Arbeit an der frischen Luft scheint oft leichter als sie tatsächlich ist.\""
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_35ptc"]
script = ExtResource("1_cbble")
speakerName = "Laya"
dialogueText = "\"Ich bin mir jedoch sicher, dass du es gut machen wirst.\""
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_uc2lt"]
script = ExtResource("1_cbble")
speakerName = "Laya"
dialogueText = "\"Diese zusätzlichen Samen sollten dein Leben etwas leichter machen.\""
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_6mop4"]
script = ExtResource("1_cbble")
speakerName = "Laya"
dialogueText = "Diese Samen habe ich bereits aufgesammelt."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

