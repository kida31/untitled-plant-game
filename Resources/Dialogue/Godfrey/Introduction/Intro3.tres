DialogueExpression = ExtResource("1_m0tyj")
dialogueText = "Well well, I get it. It's not easy for any of us."

[sub_resource type="Resource" id="Resource_ldvuu"]
script = ExtResource("2_2yo75")
speakerName = "Godfrey"
DialogueExpression = ExtResource("1_m0tyj")
dialogueText = "But no worries! Right where we stand used to be the home of an [color=red]Herbalist[/color]."

[sub_resource type="Resource" id="Resource_x1toj"]
script = ExtResource("2_2yo75")
speakerName = "Godfrey"
DialogueExpression = ExtResource("1_m0tyj")
dialogueText = "He supplied the city with medicine and took good care of us."

[sub_resource type="Resource" id="Resource_wdl46"]
script = ExtResource("2_2yo75")
