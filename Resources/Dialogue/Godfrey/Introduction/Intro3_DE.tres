[sub_resource type="Resource" id="Resource_82fqt"]
script = ExtResource("2_0cg4s")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_bkt52")
dialogueText = "Ja ja, ich verstehe schon. Wir haben es doch alle nicht so einfach."

[sub_resource type="Resource" id="Resource_ldvuu"]
script = ExtResource("2_0cg4s")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_bkt52")
dialogueText = "Aber keine Sorge! Hier, wo wir stehen, hat früher ein [color=red]Herbalist[/color] gelebt."

[sub_resource type="Resource" id="Resource_x1toj"]
script = ExtResource("2_0cg4s")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_bkt52")
dialogueText = "Er hat unsere Stadt mit Medizin versorgt und gepflegt!"

[sub_resource type="Resource" id="Resource_wdl46"]
script = ExtResource("2_0cg4s")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_bkt52")
dialogueText = "Wenn du seinen Job übernehmen kannst, wäre es sicher kein Problem, dass du dieses Haus bewohnst!"

