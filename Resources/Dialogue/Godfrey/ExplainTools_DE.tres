[sub_resource type="Resource" id="Resource_uhux7"]
script = ExtResource("2_2wq7f")
speakerName = "Gießkanne"
DialogueExpression = ExtResource("1_7h5rd")
dialogueText = "Das hier ist eine [color=red]Gießkanne[/color]. Mit ihr kannst du Pflanzen gießen."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_chwyf"]
script = ExtResource("2_2wq7f")
speakerName = "Gießkanne"
DialogueExpression = ExtResource("1_7h5rd")
dialogueText = "Die Gießkanne ist magisch und muss nie aufgefüllt werden!"
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_l81ow"]
script = ExtResource("2_2wq7f")
speakerName = "Gartenschere"
DialogueExpression = ExtResource("3_jdca0")
dialogueText = "In deinem Werkzeuggürtel befindet sich auch eine [color=red]Gartenschere[/color]. Mit ihr kannst du ganz einfach Beeren und Blätter deiner Pflanzen ernten."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_e3opx"]
script = ExtResource("2_2wq7f")
speakerName = "Gartenschere"
DialogueExpression = ExtResource("3_jdca0")
dialogueText = "Keine Sorge, es wächst alles nach. Aber natürlich nur, wenn du dich gut um deine Pflanzen kümmerst!"
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_pv1xh"]
script = ExtResource("2_2wq7f")
speakerName = "Samentasche"
DialogueExpression = ExtResource("4_4xhvu")
dialogueText = "Wenn du neue Samen hast, kannst du sie mit der [color=red]Samentasche[/color] einpflanzen."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_1u344"]
script = ExtResource("2_2wq7f")
speakerName = "Samentasche"
DialogueExpression = ExtResource("4_4xhvu")
dialogueText = "Die Samentasche enthält immer den ersten Samen, der sich in deinem Inventar befindet."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_crab0"]
script = ExtResource("2_2wq7f")
speakerName = "Schaufel"
DialogueExpression = ExtResource("5_yr0ty")
dialogueText = "Oh und wenn deine Pflanzen sterben, dann kannst du sie auch ausgraben um Platz für neue zu schaffen."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_5cghs"]
script = ExtResource("2_2wq7f")
speakerName = "Schaufel"
DialogueExpression = ExtResource("5_yr0ty")
dialogueText = "Dafür benutzt du die [color=red]Schaufel[/color]. Pass aber auf, dass du nicht ausversehen deine lebendigen Pflanzen ausgräbst!"
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_g6fgr"]
script = ExtResource("2_2wq7f")
speakerName = "Gottfried"
DialogueExpression = ExtResource("6_2pc8f")
dialogueText = "Das waren alle Werkzeuge."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

