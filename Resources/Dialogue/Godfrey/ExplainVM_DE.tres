DialogueExpression = ExtResource("1_qvwvx")
dialogueText = "In dem [color=red]Automaten[/color] dort kannst du deine [color=green]Medizin[/color] verkaufen."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_vud1m"]
script = ExtResource("2_2hi1d")
speakerName = "Automat"
DialogueExpression = ExtResource("1_qvwvx")
dialogueText = "Die Preise für die Medizin kannst du selber bestimmen. Aber stelle sicher, dass du es mit den Preisen nicht übertreibst, ja?"
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_p0lys"]
script = ExtResource("2_2hi1d")
speakerName = "Automat"
DialogueExpression = ExtResource("1_qvwvx")
dialogueText = "Je nach Bedarf dauert es immer ein wenig bevor die Sachen verkauft werden."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_afqxg"]
script = ExtResource("2_2hi1d")
speakerName = "Gottfried"
DialogueExpression = ExtResource("3_k3gny")
dialogueText = "Keine Sorge, ich werde den Leuten im Dorf Bescheid geben, dass hier wieder Medizin verkauft wird."
