[sub_resource type="Resource" id="Resource_iey8o"]
script = ExtResource("2_ynj4j")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_qlrwf")
dialogueText = "Wusstest du, dass Chuberrys zur Zeit sehr beliebt sind?"

[sub_resource type="Resource" id="Resource_wieva"]
script = ExtResource("2_ynj4j")
speakerName = "Gottfried"
DialogueExpression = ExtResource("3_eu1py")
dialogueText = "Sie wirken besonders gut gegen Erkältungen, weil sie eine [color=red]wärmende[/color] Eigenschaft haben."

[sub_resource type="Resource" id="Resource_w4rvn"]
script = ExtResource("2_ynj4j")
speakerName = "Automat"
DialogueExpression = ExtResource("4_ayj4a")
dialogueText = "In dem [color=red]Automaten[/color] dort kannst du deine [color=blue]Medizin[/color] verkaufen."

[sub_resource type="Resource" id="Resource_3a3xs"]
script = ExtResource("2_ynj4j")
speakerName = "Gottfried"
DialogueExpression = ExtResource("3_eu1py")
dialogueText = "Die Preise für die Medizin kannst du selber bestimmen. Übertreib es nur nicht, ja?"
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_cb3gn"]
script = ExtResource("2_ynj4j")
speakerName = "Gottfried"
DialogueExpression = ExtResource("5_h6m2s")
dialogueText = "Ich erinnere mich noch an Zeiten, in denen der alte Kräuterkundige wirklich nicht genug bekommen konnte!"
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_f3jpg"]
script = ExtResource("2_ynj4j")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_qlrwf")
dialogueText = "Stell doch die Chuberry ein, die du eben geerntet hast. Du musst nur ein bisschen warten, bis jemand kommt um sie zu kaufen."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

