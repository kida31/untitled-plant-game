[sub_resource type="Resource" id="Resource_acleb"]
script = ExtResource("2_kgyml")
speakerName = "Gottfried"
DialogueExpression = ExtResource("1_qjog7")
dialogueText = "Lass mich dir noch die letzten beiden Werkzeuge erklären."

[sub_resource type="Resource" id="Resource_tmh6s"]
script = ExtResource("2_kgyml")
speakerName = "Samentasche"
DialogueExpression = ExtResource("3_5uwhk")
dialogueText = "Wenn du neue Samen hast, kannst du sie mit der [color=red]Samentasche[/color] einpflanzen."

[sub_resource type="Resource" id="Resource_yg4ah"]
script = ExtResource("2_kgyml")
speakerName = "Gottfried"
DialogueExpression = ExtResource("4_wdsss")
dialogueText = "Die Samentasche enthält immer den ersten Samen, der sich in deinem Inventar befindet."

[sub_resource type="Resource" id="Resource_66we5"]
script = ExtResource("2_kgyml")
speakerName = "Gottfried"
DialogueExpression = ExtResource("5_kb3df")
dialogueText = "Oh und wenn deine Pflanzen sterben, dann kannst du sie auch ausgraben um Platz für neue zu schaffen."

[sub_resource type="Resource" id="Resource_i3e76"]
script = ExtResource("2_kgyml")
speakerName = "Gottfried"
DialogueExpression = ExtResource("4_wdsss")
dialogueText = "Dafür benutzt du die [color=red]Schaufel[/color]. Pass aber auf, dass du nicht ausversehen deine lebendigen Pflanzen ausgräbst!"

[sub_resource type="Resource" id="Resource_8febt"]
script = ExtResource("2_kgyml")
speakerName = "Gottfried"
DialogueExpression = ExtResource("4_wdsss")
dialogueText = "Tja, jetzt bist du genau so schlau wie ich. Aber komm immer gerne wieder, falls du mal was vergisst!"
