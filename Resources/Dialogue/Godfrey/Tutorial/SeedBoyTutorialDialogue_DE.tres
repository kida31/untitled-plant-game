[sub_resource type="Resource" id="Resource_sr1yf"]
script = ExtResource("1_j4rfv")
speakerName = "Laya"
dialogueText = "Die Beeren sind weg. Bekomme ich was dafür?"

[sub_resource type="Resource" id="Resource_g71vq"]
script = ExtResource("1_j4rfv")
speakerName = "Gottfried"
DialogueExpression = ExtResource("2_fg0ew")
dialogueText = "Oh, das hört sich doch gut an! Wenn aus dem Automaten etwas verkauft wurde findest du das Geld im Münzfach."

[sub_resource type="Resource" id="Resource_sqv14"]
script = ExtResource("1_j4rfv")
speakerName = "Gottfried"
DialogueExpression = ExtResource("2_fg0ew")
dialogueText = "Mit dem Geld kannst du dann neue Samen kaufen."

[sub_resource type="Resource" id="Resource_t4mgt"]
script = ExtResource("1_j4rfv")
speakerName = "Gottfried"
DialogueExpression = ExtResource("3_kbnbo")
dialogueText = "Dort drüben steht Pan Dan. Er ist der Junge vom ehemaligen Marktstandbesitzer."

[sub_resource type="Resource" id="Resource_il2tp"]
script = ExtResource("1_j4rfv")
speakerName = "Gottfried"
DialogueExpression = ExtResource("4_vyl80")
dialogueText = "Er sammelt immer alles Mögliche. Sicherlich kann er dir auch ein paar Samen verkaufen."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_ed3bb"]
script = ExtResource("1_j4rfv")
speakerName = "Gottfried"
DialogueExpression = ExtResource("2_fg0ew")
dialogueText = "Sprich ihn doch mal an. Vielleicht hat er etwas, das dich interessiert."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

