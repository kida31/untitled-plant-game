[sub_resource type="Resource" id="Resource_acleb"]
script = ExtResource("2_uewdi")
speakerName = "Godfrey"
DialogueExpression = ExtResource("1_3iskg")
dialogueText = "Ah, there is two more tools I want to tell you about."

[sub_resource type="Resource" id="Resource_tmh6s"]
script = ExtResource("2_uewdi")
speakerName = "Seed Bag"
DialogueExpression = ExtResource("3_veb4x")
dialogueText = "If you get more seeds you can plant them with your [color=red]seed bag[/color]."

[sub_resource type="Resource" id="Resource_yg4ah"]
script = ExtResource("2_uewdi")
speakerName = "Godfrey"
DialogueExpression = ExtResource("4_t887m")
dialogueText = "It always contains the first seed item of your inventory."

[sub_resource type="Resource" id="Resource_66we5"]
script = ExtResource("2_uewdi")
speakerName = "Shovel"
DialogueExpression = ExtResource("5_8ircu")
dialogueText = "And if your plants die, you can dig them out to make space for new ones."

[sub_resource type="Resource" id="Resource_i3e76"]
script = ExtResource("2_uewdi")
speakerName = "Godfrey"
DialogueExpression = ExtResource("4_t887m")
dialogueText = "To do that, use your [color=red]shovel[/color]. Be careful not to dig out alive plants!"

[sub_resource type="Resource" id="Resource_8febt"]
script = ExtResource("2_uewdi")
speakerName = "Godfrey"
DialogueExpression = ExtResource("4_t887m")
dialogueText = "Well, I taught you everything I know. But come again everytime you forget something!"
