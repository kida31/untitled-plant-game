[sub_resource type="Resource" id="Resource_sr1yf"]
script = ExtResource("1_eor28")
speakerName = "Laya"
dialogueText = "The berries are gone. Do I get anything from it?"

[sub_resource type="Resource" id="Resource_g71vq"]
script = ExtResource("1_eor28")
speakerName = "Godfrey"
DialogueExpression = ExtResource("2_iejew")
dialogueText = "Oh, doesn't that sound great! If something from the vending machine was sold, you'll find the money in the machine's coin retrieval."

[sub_resource type="Resource" id="Resource_sqv14"]
script = ExtResource("1_eor28")
speakerName = "Godfrey"
DialogueExpression = ExtResource("2_iejew")
dialogueText = "With this money you can buy new seeds."

[sub_resource type="Resource" id="Resource_t4mgt"]
script = ExtResource("1_eor28")
speakerName = "Godfrey"
DialogueExpression = ExtResource("3_xuat5")
dialogueText = "Over there you can see Pan Dan. He's the son of the former market stall owner."

[sub_resource type="Resource" id="Resource_il2tp"]
script = ExtResource("1_eor28")
speakerName = "Godfrey"
DialogueExpression = ExtResource("4_qys54")
dialogueText = "He collects all kinds of things. I am sure he will sell some seeds to you."
metadata/_custom_type_script = "uid://6j4mbe1m3l1x"

[sub_resource type="Resource" id="Resource_ed3bb"]
script = ExtResource("1_eor28")
speakerName = "Godfrey"
DialogueExpression = ExtResource("2_iejew")
dialogueText = "I suggest you ask him right away! Maybe he is offering something interesting?"
